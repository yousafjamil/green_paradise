# Copy to .env.local (never commit real keys).

# Production domain (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.ae

# Contact form email delivery via Resend (https://resend.com). Without a key the form falls back to WhatsApp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # where inquiries are delivered (defaults to the email in lib/site.ts)
CONTACT_FROM_EMAIL=          # e.g. "Green Paradise <hello@your-domain.ae>" after verifying the domain in Resend

# Privacy-friendly analytics (Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Exact business address or "lat,lng" for the contact page map. Leave empty to show Abu Dhabi.
NEXT_PUBLIC_MAP_QUERY=
